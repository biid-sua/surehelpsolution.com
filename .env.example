APP_NAME="SureHelp Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production: LOG_LEVEL=warning, LOG_STACK=daily
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=surehelp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: true (cookies only over HTTPS)
SESSION_SECURE_COOKIE=false

# Mobile/API personal access tokens expire after this many minutes (30 days)
SANCTUM_TOKEN_EXPIRATION=43200

# Extra browser origins allowed to call /api (comma-separated). Our own APP_URL is always allowed.
CORS_ALLOWED_ORIGINS=

# Retention: audit trail (days) and security log files (days)
AUDIT_RETENTION_DAYS=730
LOG_SECURITY_DAYS=90

# Assign new organizations/agents to the whole agent pool (docs/decisions.md D3)
TENANCY_AUTO_ASSIGN_AGENTS=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Where website contact-form submissions are emailed (defaults to config/company.php)
# MAIL_CONTACT_TO=info@surehelpsolutions.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Firebase Cloud Messaging (mobile push). Legacy server-key API; migration to HTTP v1 is planned.
FCM_SERVER_KEY=
FCM_SENDER_ID=
FCM_DEFAULT_SOUND=default
FCM_ANDROID_CHANNEL_ID=default-channel

# --- Planned integrations (not used yet; see docs/decisions.md) ---
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# ANTHROPIC_API_KEY=

VITE_APP_NAME="${APP_NAME}"
