# Root folders such as app/ share names with routes (/app); never append a slash to them, or Laravel strips it again in a loop.
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS on the canonical host (must run before the rewrite into public/ below).
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-SSL} !on
    RewriteCond %{HTTP_HOST} ^(www\.)?surehelpsolution\.com$ [NC]
    RewriteRule ^(.*)$ https://surehelpsolution.com/$1 [R=301,L]

    # SECURITY: the project root is the web root, so secrets, manifests, logs and archives are refused outright.
    RewriteRule (^|/)(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|artisan|error_log|php\.ini|\.user\.ini|phpunit\.xml|vite\.config\.js|fix-encoding\.php|task\.md|.*\.zip|.*\.log)$ - [F,L,NC]

    # Drop trailing slashes here; after the rewrite below, public/.htaccess would redirect to /public/... instead.
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve every request from public/, whether or not a same-named file or folder exists at the root.
    # Source folders are never reachable, and URLs that share a folder's name still reach Laravel:
    # the client portal lives at /app and uploads at /storage, so those must not be blocked by name.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag display_errors Off
   php_value max_execution_time 60
   php_value max_input_time 60
   php_value max_input_vars 1000
   php_value memory_limit 1024M
   php_value post_max_size 1024M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php83"
   php_value upload_max_filesize 1024M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
   php_value max_execution_time 60
   php_value max_input_time 60
   php_value max_input_vars 1000
   php_value memory_limit 1024M
   php_value post_max_size 1024M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php83"
   php_value upload_max_filesize 1024M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit
